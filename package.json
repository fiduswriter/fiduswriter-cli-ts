{
    "name": "@fiduswriter/cli",
    "version": "0.1.6",
    "description": "Command-line interface for Fidus Writer document conversion",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "fidusconvert": "dist/bin/fidusconvert.js"
    },
    "scripts": {
        "build": "tsc",
        "prepare": "npm run build",
        "start": "node dist/bin/fidusconvert.js",
        "test": "tsx --test test/*.test.ts",
        "lint": "eslint src test",
        "lint:fix": "eslint src test --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "keywords": [
        "fiduswriter",
        "document",
        "converter",
        "cli",
        "docx",
        "odt",
        "latex",
        "html",
        "epub",
        "jats",
        "pandoc"
    ],
    "author": "Johannes Wilm",
    "license": "AGPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "ssh://git@codeberg.org/fiduswriter/fiduswriter-cli.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@fiduswriter/books-document": "^0.1.2",
        "@fiduswriter/document": "^0.2.4",
        "citeproc-plus": "^1.0.1",
        "commander": "^13.1.0",
        "fwtoolkit": "^0.1.3",
        "happy-dom": "^20.10.6",
        "jszip": "^3.10.1",
        "prosemirror-commands": "^1.7.1",
        "prosemirror-history": "^1.5.0",
        "prosemirror-keymap": "^1.2.3",
        "prosemirror-state": "^1.4.4",
        "prosemirror-view": "^1.41.9"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.0.0",
        "eslint": "^10.6.0",
        "fast-xml-parser": "^5.9.3",
        "globals": "^15.15.0",
        "prettier": "^3.8.5",
        "tsx": "^4.22.4",
        "typescript": "^5.8.0",
        "typescript-eslint": "^8.62.0"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "files": [
        "dist/",
        "templates/"
    ]
}
